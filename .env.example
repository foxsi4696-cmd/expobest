# Turso Cloud SQLite Configuration (Production database for Vercel)
# Create your free database and get URL + token at: https://turso.tech
TURSO_DATABASE_URL=libsql://expobest-your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# Local server port (optional, defaults to 3001)
PORT=3001
