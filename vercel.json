{
  "version": 2,
  "functions": {
    "api/[...path].js": {
      "includeFiles": "data/**,public/uploads/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/[...path]" },
    { "source": "/uploads/:path*", "destination": "/api/[...path]" },
    { "source": "/((?!.*\\.).*)", "destination": "/index.html" }
  ]
}