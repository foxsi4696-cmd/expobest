{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "data/**,public/uploads/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/uploads/:path*", "destination": "/api/index.js" },
    { "source": "/((?!.*\\.).*)", "destination": "/index.html" }
  ]
}